[Unit]
Description=David Israel news static site origin
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m http.server 18766 --bind 127.0.0.1 --directory /home/trentoo/projects/david-israel-news
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=default.target
